{
  "name": "free-bj",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"tsx watch src/index.ts\" \"vite\"",
    "build": "vite build && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external --sourcemap",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "chain:test": "forge test --root contracts",
    "chain:deploy": "bash scripts/rps/deploy.sh",
    "chain:e2e": "bash scripts/rps-local.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "testcontainers": "^11.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
