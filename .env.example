# Local defaults for `npm run dev` against `docker compose up db`.
# The app container does not read this file. Compose sets its own environment.
LEADERBOARD_DATABASE_URL=postgres://leaderboard_user:leaderboard_pass@127.0.0.1:54329/freebj_leaderboard
ADMIN_DATABASE_URL=postgres://admin_user:admin_pass@127.0.0.1:54329/freebj_admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
PORT=8080
# Set to true only behind HTTPS. Leave unset for local HTTP.
COOKIE_SECURE=false

# Rock-paper-scissors page. These are public. `npm run chain:env` writes them to .env.local
# after `npm run chain:deploy`. Vite reads them at startup, so restart `npm run rps:dev` after a change.
# Leave the addresses empty and the page shows the setup steps. Do not put a private key here.
# VITE_RPS_CHAIN_ID=31337
# VITE_RPS_RPC_URL=http://127.0.0.1:8545
# VITE_RPS_ADDRESS=
# VITE_USDC_ADDRESS=
# Origin the Node server adds to connect-src. Match the baked VITE_RPS_RPC_URL when you serve dist/web from Node.
# RPS_RPC_URL=http://127.0.0.1:8545
